---
/* Footer: name, location + live local time, mail, socials (only real ones), and the motion switch
   (pauses every loop and scroll animation; remembered per visitor). */
import Spark from './Spark.astro';
import { person } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-id">
      <a href="/" class="footer-logo"><Spark size={15} /><span>{person.name}</span></a>
      <p>{person.role}. {person.city} — <span data-localtime data-tz={person.tz}>UTC+2</span></p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={`mailto:${person.email}`}>{person.email}</a>
      {person.upworkUrl && <a href={person.upworkUrl} rel="me noopener" target="_blank">Upwork</a>}
      {person.socials.map((s) => <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>)}
      <button class="motion-switch" type="button" data-motion-switch data-on="Motion on" data-off="Motion off" aria-pressed="true">
        <span class="motion-dot" aria-hidden="true"></span><span data-motion-label>Motion on</span>
      </button>
    </nav>
    <p class="footer-copy">© {year} {person.name}</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px 32px;
    align-items: center;
    padding-block: 28px 36px;
    font-size: 14px;
    color: var(--muted);
  }
  .footer-logo { display: inline-flex; align-items: baseline; gap: 8px; font-family: var(--font-serif); font-size: 19px; font-weight: 500; color: var(--ink); }
  .footer-id p { margin-top: 4px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; justify-content: flex-end; }
  .footer-links a { font-weight: 500; color: var(--soft); }
  .footer-links a:hover { color: var(--green); }
  .footer-copy { grid-column: 1 / -1; font-size: 13px; }
  .motion-switch {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px;
    font-size: 13px; font-weight: 600; color: var(--soft);
  }
  .motion-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .motion-switch[aria-pressed="false"] .motion-dot { background: transparent; border: 1.5px solid var(--muted); }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { justify-content: flex-start; }
  }
</style>

<script>
  /* Live local time, so a client sees at a glance whether a reply can come today. */
  document.querySelectorAll<HTMLElement>('[data-localtime]').forEach((el) => {
    const tz = el.dataset.tz || 'Europe/Kyiv';
    const fmt = () => {
      try {
        const t = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date());
        el.textContent = `${t} local time`;
      } catch { /* keep the static text */ }
    };
    fmt();
    setInterval(fmt, 30_000);
  });

  /* Motion switch: data-motion="off" on <html> stops loops (LoopVideo listens for "motionchange")
     and freezes CSS animation; the choice is remembered when storage is available. */
  const html = document.documentElement;
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-motion-switch]'));
  const sync = () => {
    const off = html.dataset.motion === 'off';
    btns.forEach((b) => {
      b.setAttribute('aria-pressed', String(!off));
      const label = b.querySelector<HTMLElement>('[data-motion-label]');
      if (label) label.textContent = (off ? b.dataset.off : b.dataset.on) ?? '';
    });
  };
  sync();
  btns.forEach((b) => b.addEventListener('click', () => {
    const off = html.dataset.motion !== 'off';
    if (off) html.dataset.motion = 'off'; else delete html.dataset.motion;
    try { localStorage.setItem('motion', off ? 'off' : 'on'); } catch { /* not stored */ }
    sync();
    window.dispatchEvent(new Event('motionchange'));
  }));
</script>
