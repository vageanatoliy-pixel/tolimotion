---
/* "My recent work" — the card under the hero. Replaced the interactive
   Timeline orrery (src/components/TimelineScene.astro, kept in the repo, unmounted).

   To add a piece: drop the files into /public/recent/ and list them here.
     src    — H.264 MP4, ideally ≤ 20 MB
     poster — first frame as JPG (shown before play, preload="none" keeps the page light)
     aspect — '16 / 9' (default) or '9 / 16' for vertical ads
   One entry = one full-width player; two or more = a grid. */
type Piece = { src: string; poster: string; title: string; note?: string; aspect?: string };
const pieces: Piece[] = [
  { src: '/recent/ad2.mp4', poster: '/recent/ad2.jpg', title: 'CISSP — DestCert', note: '21 s · edit, motion, captions' },
];
---
<section class="recent-section" id="recent">
  <div class="container">
    <div class="recent">
      <div class="recent-head">
        <p class="eyebrow eyebrow--green">My recent work</p>
        <p class="recent-note">{pieces.length ? 'click to play · sound on' : 'new piece · coming soon'}</p>
      </div>

      {pieces.length ? (
        <div class={`pieces pieces--${pieces.length === 1 ? 'one' : 'grid'}`}>
          {pieces.map((p) => (
            <figure class="piece" style={`aspect-ratio: ${p.aspect ?? '16 / 9'}`}>
              <video
                class="piece-video"
                src={p.src}
                poster={p.poster}
                preload="none"
                playsinline
                aria-label={`${p.title} — video`}
              ></video>
              <button class="piece-play" type="button" aria-label={`Play ${p.title}`}>
                <span class="play"><span class="play-tri" aria-hidden="true"></span></span>
              </button>
              <figcaption class="piece-cap">
                <span class="piece-title">{p.title}</span>
                {p.note && <span class="piece-sub">{p.note}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="piece piece--empty" aria-hidden="true">
          <span class="play"><span class="play-tri"></span></span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .recent-section { padding-block: 16px clamp(48px, 6vw, 80px); }
  .recent {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: clamp(16px, 2.4vw, 28px);
  }
  .recent-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(14px, 1.8vw, 22px);
  }
  .recent-note { font-size: 13px; font-weight: 500; color: var(--muted); }

  .pieces--one { display: grid; }
  .pieces--grid {
    display: grid;
    gap: clamp(12px, 1.6vw, 20px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .piece {
    position: relative;
    margin: 0;
    width: 100%;
    max-height: 78vh;
    margin-inline: auto;
    border-radius: 22px;
    overflow: hidden;
    background: var(--ink);
    border: 1px solid var(--line);
  }
  .piece-video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .piece-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 18%, transparent);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .piece.is-playing .piece-play { opacity: 0; pointer-events: none; }
  .piece-play:hover .play { transform: scale(1.06); }
  .play {
    width: clamp(64px, 7vw, 96px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--green);
    display: grid;
    place-items: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .play-tri {
    width: 0; height: 0;
    border-block: 11px solid transparent;
    border-left: 18px solid var(--cream);
    margin-left: 5px;
  }
  .piece-cap {
    position: absolute;
    left: 18px; right: 18px; bottom: 16px;
    display: flex; flex-direction: column; gap: 2px;
    color: var(--cream);
    pointer-events: none;
    text-shadow: 0 1px 10px color-mix(in srgb, var(--ink) 60%, transparent);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .piece.is-playing .piece-cap { opacity: 0; }
  .piece-title { font-family: var(--font-serif); font-weight: 500; font-size: clamp(18px, 1.8vw, 24px); }
  .piece-sub { font-size: 13px; opacity: 0.8; }

  /* placeholder until the first piece lands */
  .piece--empty {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--band) 0%, color-mix(in srgb, var(--green) 38%, var(--band)) 100%);
  }
</style>

<script>
  /* Click the overlay → play with native controls; pausing brings the overlay back. */
  document.querySelectorAll<HTMLElement>('.piece').forEach((piece) => {
    const video = piece.querySelector<HTMLVideoElement>('.piece-video');
    const btn = piece.querySelector<HTMLButtonElement>('.piece-play');
    if (!video || !btn) return;
    btn.addEventListener('click', () => {
      video.controls = true;
      video.play();
    });
    video.addEventListener('play', () => piece.classList.add('is-playing'));
    video.addEventListener('pause', () => piece.classList.remove('is-playing'));
    video.addEventListener('ended', () => {
      piece.classList.remove('is-playing');
      video.controls = false;
    });
  });
</script>
