---
/* "My recent work" — the card under the hero. Replaced the interactive
   Timeline orrery (src/components/TimelineScene.astro, kept in the repo, unmounted).

   To add a piece: drop the files into /public/recent/ and list them here.
     src    — H.264 MP4, ideally ≤ 20 MB
     poster — first frame as JPG (shown before play, preload="none" keeps the page light)
     aspect — '16 / 9' (default) or '9 / 16' for vertical ads
   One entry = one full-width player; two or more = a grid. */
import VideoPiece from './VideoPiece.astro';
type Piece = { src: string; poster: string; title: string; note?: string; aspect?: string };
const pieces: Piece[] = [
  { src: '/recent/ad2.mp4', poster: '/recent/ad2.jpg', title: 'CISSP — DestCert', note: '21 s · edit, motion, captions' },
];
---
<section class="recent-section" id="recent">
  <div class="container">
    <div class="recent">
      <div class="recent-head">
        <p class="eyebrow eyebrow--green">My recent work</p>
        <p class="recent-note">{pieces.length ? 'click to play · sound on' : 'new piece · coming soon'}</p>
      </div>

      {pieces.length ? (
        <div class={`pieces pieces--${pieces.length === 1 ? 'one' : 'grid'}`}>
          {pieces.map((p) => (
            <VideoPiece src={p.src} poster={p.poster} label={p.title} title={p.title} note={p.note} aspect={p.aspect} />
          ))}
        </div>
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span class="play"><span class="play-tri"></span></span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .recent-section { padding-block: 16px clamp(48px, 6vw, 80px); }
  .recent {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: clamp(16px, 2.4vw, 28px);
  }
  .recent-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(14px, 1.8vw, 22px);
  }
  .recent-note { font-size: 13px; font-weight: 500; color: var(--muted); }

  .pieces--one { display: grid; }
  .pieces--grid {
    display: grid;
    gap: clamp(12px, 1.6vw, 20px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  /* placeholder until the first piece lands */
  .placeholder {
    aspect-ratio: 16 / 9;
    border-radius: 22px;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--band) 0%, color-mix(in srgb, var(--green) 38%, var(--band)) 100%);
  }
  .play {
    width: clamp(64px, 7vw, 96px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--green);
    display: grid;
    place-items: center;
  }
  .play-tri {
    width: 0; height: 0;
    border-block: 11px solid transparent;
    border-left: 18px solid var(--cream);
    margin-left: 5px;
  }
</style>
