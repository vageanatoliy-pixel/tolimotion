---
/* Process: the five steps a client goes through (what they approve at each), then one real project
   shown at three stages — the proof a portfolio usually hides. Material: CISSP MasterClass Ad 1 for
   Destination Certification (rough animatic 23 Oct 2026 → style frames 1 Nov → final 2 Nov; square and
   vertical cuts 4 Nov). Drafts of client work: Toli to confirm with DestCert before this goes live. */
import LoopVideo from './LoopVideo.astro';
import Marker from './Marker.astro';
import { steps, showPendingClientWork } from '../data/site';

const looks = [
  { img: '/loops/proc-ad1-sf-A_waterline.jpg', tag: 'A', name: 'Waterline', verdict: 'Too literal', pick: false },
  { img: '/loops/proc-ad1-sf-B_depth-field.jpg', tag: 'B', name: 'Depth field', verdict: 'Runner-up', pick: false },
  { img: '/loops/proc-ad1-sf-C_thin-layer.jpg', tag: 'C', name: 'Thin layer', verdict: 'Chosen', pick: true },
];
---
<section class="section process" id="process" aria-labelledby="process-title">
  <div class="container">
    <Marker tc="00:31" label="Process" />
    <h2 class="h-display h-section process-title" id="process-title">You see it early, <em>and often.</em></h2>
    <p class="process-lead">
      Animation projects run on five steps. You sign off the script, the look and the timing before full
      animation starts — so the expensive part never goes in the wrong direction. Edits skip steps 02 and 03.
    </p>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="step-key" aria-hidden="true"></span>
          <p class="step-n">{s.n}</p>
          <h3 class="step-name">{s.name}</h3>
          <p class="step-text">{s.text}</p>
          <p class="step-you">{s.you}</p>
        </li>
      ))}
    </ol>

    {showPendingClientWork && (
    <div class="inside" data-status="ask">
      <div class="inside-head">
        <Marker tc="00:39" label="Inside one project" />
        <h3 class="h-display inside-title">CISSP ad: <em>animatic to final</em> in ten days.</h3>
        <p class="inside-lead">
          The opening line is “CISSP is a mile wide and an inch deep.” Here is the same ad at three stages,
          with the two decisions that changed it most.
        </p>
      </div>

      <div class="stages">
        <figure class="stage" data-loop-host>
          <LoopVideo name="proc-ad1-rough-mile" alt="Rough animatic: plain text “A mile wide. An inch deep.” on a violet gradient, then a row of topic pills slides in." />
          <figcaption><span class="stage-date">23 Oct</span><b>Animatic</b> Boards on a camera, timed to the voice-over.</figcaption>
        </figure>
        <figure class="stage stage--looks">
          <div class="looks">
            {looks.map((l) => (
              <div class={`look${l.pick ? ' look--pick' : ''}`}>
                <img src={l.img} alt={`Style frame ${l.tag}, ${l.name}: “An inch deep.”`} loading="lazy" decoding="async" width="960" height="540" />
                <span class="look-tag">{l.tag} · {l.verdict}</span>
              </div>
            ))}
          </div>
          <figcaption><span class="stage-date">1 Nov</span><b>Three looks</b> for the hook frame. The literal one was dropped; the abstract “thin layer” was built.</figcaption>
        </figure>
        <figure class="stage" data-loop-host>
          <LoopVideo name="cissp-ad1-mile" alt="Final ad: “A mile wide” resolves out of blur, then topic pills float over the glowing line “An inch deep”." />
          <figcaption><span class="stage-date">2 Nov</span><b>Final</b> Kinetic type, depth and one camera move.</figcaption>
        </figure>
      </div>

      <div class="decision">
        <div class="decision-pair">
          <figure data-loop-host>
            <LoopVideo name="proc-ad1-rough-pass" alt="Animatic: two donut charts side by side, 93.6% and 100%." />
            <figcaption>Before: two charts compete for the eye.</figcaption>
          </figure>
          <span class="decision-arrow" aria-hidden="true">→</span>
          <figure data-loop-host>
            <LoopVideo name="proc-ad1-final-pass" alt="Final: one large number counts up to 93.6% — pass on their first attempt — then on to nearly 100% by the second." />
            <figcaption>After: one number counts through both results.</figcaption>
          </figure>
        </div>
        <p class="decision-text">
          <b>Decision:</b> the animatic showed DestCert’s two pass rates as two donut charts — a stock dashboard layout.
          In the final, one number counts through time: 93.6% pass on the first attempt, then on to nearly 100%
          by the second. One hero moment instead of two halves.
        </p>
      </div>
      <span class="draft-flag" aria-hidden="true">Client drafts — confirm with DestCert</span>
    </div>
    )}
  </div>
</section>

<style>
  .process-title { margin-top: 14px; max-width: 18ch; }
  .process-title em, .inside-title em { font-style: italic; color: var(--green); }
  .process-lead { margin-top: 18px; max-width: 60ch; font-family: var(--font-serif); font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6; color: var(--soft); }

  /* steps sit on one line like keyframes on a curve */
  .steps {
    list-style: none; margin: clamp(36px, 4vw, 56px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0;
    position: relative;
  }
  .steps::before {
    content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: var(--line);
  }
  .step { position: relative; padding: 30px 22px 0 0; }
  .step-key {
    position: absolute; top: 1px; left: 0; width: 13px; height: 13px;
    background: var(--paper); border: 1.5px solid var(--green); transform: rotate(45deg); border-radius: 2px;
  }
  .step:last-child .step-key { background: var(--green); }
  .step-n { font-size: 12px; font-weight: 700; color: var(--green); font-feature-settings: 'tnum'; letter-spacing: 0.06em; }
  .step-name { margin-top: 6px; font-family: var(--font-serif); font-weight: 500; font-size: clamp(20px, 1.7vw, 24px); line-height: 1.15; }
  .step-text { margin-top: 8px; font-size: 15.5px; line-height: 1.55; color: var(--soft); }
  .step { display: flex; flex-direction: column; }
  .step-you { margin-top: auto; padding-top: 12px; font-size: 13.5px; font-weight: 650; color: var(--green); }

  .inside {
    position: relative;
    margin-top: clamp(56px, 7vw, 96px);
    padding: clamp(22px, 3vw, 40px);
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--card);
    border: 1px solid var(--line);
  }
  .inside-title { margin-top: 10px; font-size: clamp(28px, 3.2vw, 44px); max-width: 22ch; }
  .inside-lead { margin-top: 12px; max-width: 62ch; font-size: 15.5px; line-height: 1.6; color: var(--soft); }

  .stages { margin-top: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 14px; align-items: start; }
  .stage--looks { grid-column: 1 / -1; grid-row: 2; }
  .stage { margin: 0; }
  .stage :global(.loop), .look img { border-radius: 12px; }
  .stage figcaption, .decision figcaption { margin-top: 10px; font-size: 13.5px; line-height: 1.5; color: var(--soft); }
  .stage figcaption b { color: var(--ink); margin-right: 4px; }
  .stage-date {
    display: inline-block; margin-right: 8px; padding: 2px 7px; border-radius: 6px;
    background: var(--ink); color: var(--cream);
    font-size: 11px; font-weight: 700; font-feature-settings: 'tnum';
  }
  .looks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .look { position: relative; }
  .look img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: 0.62; filter: saturate(0.7); }
  .look--pick img { opacity: 1; filter: none; outline: 2px solid var(--green); outline-offset: 2px; }
  .look-tag { display: block; margin-top: 6px; font-size: 11.5px; font-weight: 600; color: var(--muted); }
  .look--pick .look-tag { color: var(--green); }

  .decision {
    margin-top: clamp(28px, 3vw, 40px); padding-top: clamp(24px, 3vw, 36px); border-top: 1px solid var(--line);
    display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px 40px; align-items: center;
  }
  .decision-pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; }
  .decision-pair figure { margin: 0; }
  .decision-pair :global(.loop) { border-radius: 12px; }
  .decision-arrow { font-family: var(--font-serif); font-size: 28px; color: var(--green); }
  .decision-text { font-family: var(--font-serif); font-size: clamp(16px, 1.35vw, 19px); line-height: 1.6; color: var(--soft); }
  .decision-text b { font-family: var(--font-sans); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--green); }

  .draft-flag { display: none; }
  :global(html[data-draft]) .draft-flag {
    display: block; position: absolute; top: 14px; right: 14px;
    padding: 4px 9px; border-radius: 999px; background: var(--clay); color: var(--cream);
    font-size: 11px; font-weight: 700;
  }

  @media (max-width: 980px) {
    .steps { grid-template-columns: 1fr; }
    .steps::before { left: 6px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .step { padding: 0 0 26px 34px; }
    .step-key { top: 4px; }
    .stages { grid-template-columns: 1fr; }
    .decision { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .decision-pair { grid-template-columns: 1fr; }
    .decision-arrow { transform: rotate(90deg); justify-self: center; }
  }
</style>
