---
/* Section label as an edit marker: the timecode where this "chapter" of the page sits, then the name
   in sentence case. Replaces the tracked ALL-CAPS eyebrow (generic template chrome). */
interface Props { tc: string; label: string; light?: boolean; class?: string }
const { tc, label, light = false, class: cls = '' } = Astro.props;
---
<p class={`marker${light ? ' marker--light' : ''} ${cls}`}>
  <span class="marker-tc">{tc}</span>
  <span class="marker-label">{label}</span>
</p>

<style>
  .marker { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; color: var(--soft); }
  .marker-tc {
    display: inline-grid; place-items: center; height: 22px; padding-inline: 7px; border-radius: 6px;
    background: var(--ink); color: var(--cream);
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.03em; font-feature-settings: 'tnum';
  }
  .marker--light { color: color-mix(in srgb, var(--cream) 78%, transparent); }
  .marker--light .marker-tc { background: var(--cream); color: var(--ink); }
</style>
