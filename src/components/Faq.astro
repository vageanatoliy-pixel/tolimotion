---
/* FAQ: the questions buyers ask before writing — price, time, revisions, AI, ownership, agencies,
   payment, time zone. Native <details>, works without JS. Draft-only items wait for Toli's facts. */
import Marker from './Marker.astro';
import { faq } from '../data/site';
---
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div>
      <Marker tc="01:24" label="Questions" />
      <h2 class="h-display h-section faq-title" id="faq-title">Before you write.</h2>
      <p class="faq-side">Anything else? Ask in the brief below.</p>
    </div>
    <div class="faq-list">
      {faq.map((f) => (
        <details class={f.draft ? 'qa qa--draft' : 'qa'} name="faq">
          <summary><span>{f.q}</span><span class="qa-icon" aria-hidden="true"></span></summary>
          <p>{f.a || 'Answer only with your real setup (generator, battery, second connection) — or remove this question.'}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(28px, 5vw, 80px); align-items: start; }
  .faq-title { margin-top: 14px; }
  .faq-title em { font-style: italic; color: var(--green); }
  .faq-side { margin-top: 16px; max-width: 34ch; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .faq-list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding-block: 20px; cursor: pointer; list-style: none;
    font-family: var(--font-serif); font-size: clamp(19px, 1.6vw, 23px); line-height: 1.3;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa-icon { position: relative; flex: none; width: 14px; height: 14px; }
  .qa-icon::before, .qa-icon::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px;
    background: var(--ink); transition: transform var(--dur-base) var(--ease-out);
  }
  .qa-icon::after { transform: rotate(90deg); }
  .qa[open] .qa-icon::after { transform: rotate(0deg); }
  .qa p { padding: 0 40px 22px 0; max-width: 64ch; font-size: 16.5px; line-height: 1.65; color: var(--soft); }
  .qa--draft { display: none; }
  :global(html[data-draft]) .qa--draft { display: block; border-bottom-style: dashed; }
  :global(html[data-draft]) .qa--draft p { color: var(--clay); }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
