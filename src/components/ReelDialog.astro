---
/* One film player in a dialog, with sound — for the showreel (hero "Watch the reel") and the
   "Watch the film" quick views on work tiles. Any element with data-film="url" opens it;
   data-poster and data-title are optional. Nothing downloads until a film is opened. */
---
<dialog class="reel" data-reel aria-label="Film player">
  <div class="reel-inner">
    <video class="reel-video" preload="none" controls playsinline></video>
    <form method="dialog" class="reel-bar">
      <p data-reel-title><b>Showreel</b> · 0:26</p>
      <button class="reel-close" type="submit" aria-label="Close the player">Close ✕</button>
    </form>
  </div>
</dialog>

<style>
  .reel {
    width: min(1200px, 94vw); max-height: 92vh; padding: 0; border: 0; border-radius: 18px;
    background: var(--ink); color: var(--cream); overflow: hidden;
  }
  .reel::backdrop { background: color-mix(in srgb, var(--ink) 82%, transparent); backdrop-filter: blur(6px); }
  .reel-video { width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .reel-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 18px; font-size: 14px; }
  .reel-close { color: var(--cream); font-weight: 600; font-size: 14px; padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-reel]');
  const video = dlg?.querySelector<HTMLVideoElement>('video');
  const title = dlg?.querySelector<HTMLElement>('[data-reel-title]');
  let opener: HTMLElement | null = null;
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-film]');
    if (!t || !dlg || !video) return;
    e.preventDefault();
    e.stopPropagation();
    opener = t;
    if (video.getAttribute('src') !== t.dataset.film) {
      video.src = t.dataset.film ?? '';
      video.poster = t.dataset.poster ?? '';
    }
    if (title) title.innerHTML = t.dataset.title ?? '';
    dlg.showModal();
    video.play().catch(() => {});
  });
  dlg?.addEventListener('close', () => { video?.pause(); opener?.focus(); });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
