---
/* Case page: two CISSP MasterClass ads for Destination Certification, each in 16:9, 1:1 and 9:16, with their
   storyboards (drawn in code: src/data/cissp-storyboard.ts) and GIF downloads. Copy: src/data/cases.ts.
   This URL is the UI-animation sample Toli sends in proposals — keep it stable. */
import Pearl from '../../layouts/Pearl.astro';
import Loop from '../../components/pearl/Loop.astro';
import Film from '../../components/pearl/Film.astro';
import Stage from '../../components/pearl/Stage.astro';
import Facts from '../../components/pearl/Facts.astro';
import Features from '../../components/pearl/Features.astro';
import CaseEnd from '../../components/pearl/CaseEnd.astro';
import Storyboard from '../../components/Storyboard.astro';
import { cisspAds, cisspFacts, cissp } from '../../data/cases';
const [first] = cisspAds;
const chip = (n: string, len: string) => `Watch ad ${Number(n)} · 0:${len.replace(/\D/g, '').padStart(2, '0')}`;
const DL = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Pearl title={cissp.seoTitle} description={cissp.description}>
  <main id="main">
    <section class="hero section case-hero" aria-labelledby="case-title">
      <p class="wrap crumbs"><span><a href="/#work">← All work</a></span><span>{cissp.label}</span></p>
      <div class="wrap hero__body">
        <h1 class="h-hero indent" id="case-title">{cissp.title}</h1>
        <div class="case__intro indent">
          <div class="block block--sub">
            <p class="t-lead">{cissp.lead}</p>
            <div class="hero__cta">
              <button class="pill pill--solid pill--lg" type="button" data-play={`${first.id}-film`}><span class="tri" aria-hidden="true"></span>{chip(first.n, first.len)}</button>
            </div>
          </div>
          <Facts rows={cisspFacts} />
        </div>
      </div>
      <div class="hero__media" data-loop-host>
        <Loop name={cissp.heroLoop.name} alt={cissp.heroLoop.alt} cls="loop--lg" eager />
      </div>
    </section>

    {cisspAds.map((ad) => (
      <section class="wrap section case" id={ad.id} aria-labelledby={`${ad.id}-title`}>
        <div class="block indent reveal">
          <Stage num={ad.n}>{ad.len}</Stage>
          <h2 class="h-xl" id={`${ad.id}-title`}>{ad.name}</h2>
          <p class="note">{ad.text}</p>
        </div>
        <figure class="media reveal">
          <Film id={`${ad.id}-film`} src={ad.film.src} poster={ad.film.poster} title={`Ad ${ad.n}, ${ad.name}`} chip={chip(ad.n, ad.len)} />
          <figcaption><b>16:9</b><span>YouTube · Web</span><span>{ad.film.note}</span></figcaption>
        </figure>
        <div class="formats formats--pair reveal">
          {ad.formats.map((f) => (
            <figure data-loop-host>
              <Loop name={f.loop} alt={f.alt} ratio={f.ratio === '1:1' ? '1 / 1' : '9 / 16'} />
              <figcaption>
                <span><b>{f.ratio}</b>{f.use}</span>
                <a class="pill pill--white pill--sm dl" href={f.gif} download={`${f.file}.gif`}><Fragment set:html={DL} />Download GIF <small>{f.size}</small></a>
              </figcaption>
            </figure>
          ))}
          <p class="note">{cissp.reframed}</p>
        </div>
        <div class="board reveal">
          <Stage>Storyboard · Ad {ad.n}</Stage>
          <h3 class="h-l">{cissp.board.title}</h3>
          <p class="note">{cissp.board.lead}</p>
          <Storyboard boards={ad.boards} label={`Storyboard of ad ${ad.n}, ${ad.name}`} />
        </div>
      </section>
    ))}

    <section class="wrap section" aria-label="How they were made">
      <Features items={cissp.notes} class="reveal" />
    </section>

    <CaseEnd ask={cissp.ask} subject={cissp.subject} next={{ href: '/work/advertima-audience-ai/', client: 'Advertima · paid creative test', title: 'Audience AI explainer', loop: 'adv-holo', alt: 'Advertima explainer: a family in a supermarket turns into glowing anonymous figures inside a sensor view.' }} />
  </main>
</Pearl>
