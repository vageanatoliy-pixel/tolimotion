---
/* Case page: Fitrise stadium LED intro (two cuts, downloadable) and the reel system for the founder's
   Instagram talks (hook, four title looks, four caption styles). Copy: src/data/cases.ts. */
import Pearl from '../../layouts/Pearl.astro';
import Loop from '../../components/pearl/Loop.astro';
import Stage from '../../components/pearl/Stage.astro';
import Facts from '../../components/pearl/Facts.astro';
import Features from '../../components/pearl/Features.astro';
import CaseEnd from '../../components/pearl/CaseEnd.astro';
import { fitCuts, fitReels, fitTitles, fitFacts, fitrise } from '../../data/cases';
const R = fitrise.reels;
const DL = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0 3.5-3.5M8 10 4.5 6.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Pearl title={fitrise.seoTitle} description={fitrise.description}>
  <main id="main">
    <section class="hero section case-hero" aria-labelledby="case-title">
      <p class="wrap crumbs"><span><a href="/#work">← All work</a></span><span>{fitrise.label}</span></p>
      <div class="wrap hero__body">
        <h1 class="h-hero indent" id="case-title">{fitrise.title}</h1>
        <div class="case__intro indent">
          <p class="t-lead">{fitrise.lead}</p>
          <Facts rows={fitFacts} />
        </div>
      </div>
      <div class="hero__media" data-loop-host>
        <Loop name={fitrise.heroLoop.name} alt={fitrise.heroLoop.alt} ratio="16 / 3" cls="loop--lg" eager />
      </div>
    </section>

    <section class="wrap section case" aria-label="Two cuts">
      {fitCuts.map((c) => (
        <Fragment>
          <div class="block block--sub indent reveal" id={c.id}>
            <Stage num={c.n} cap={false}>Loop · 15 s</Stage>
            <h2 class="h-xl">{c.name} cut</h2>
            <p class="note">{c.text}</p>
          </div>
          <figure class="media reveal" data-loop-host>
            <Loop name={c.loop} alt={c.alt} ratio="16 / 3" cls="loop--led" />
            <figcaption><b>1440 × 270</b><span>{c.note}</span></figcaption>
          </figure>
          <p class="case__links indent reveal">
            <a class="pill pill--solid dl" href={c.gif} download={`${c.file}.gif`}><Fragment set:html={DL} />Download GIF <small>{c.gifSize}</small><span class="sr-only">: {c.name} cut</span></a>
            <a class="pill pill--white dl" href={c.mp4} download={`${c.file}_25fps.mp4`}>MP4 <small>{c.mp4Size}</small><span class="sr-only">: {c.name} cut, 25 fps</span></a>
          </p>
        </Fragment>
      ))}
      <Features items={fitrise.notes} class="reveal" label="Built for the wall" />
    </section>

    <section class="wrap section case" id="reels" aria-labelledby="reels-title">
      <div class="block indent reveal">
        <Stage>{R.label}</Stage>
        <h2 class="h-xl" id="reels-title">{R.title}</h2>
        <p class="note">{R.lead}</p>
      </div>
      <div class="duo reveal" data-loop-host>
        <Loop name={R.hook.loop} alt={R.hook.alt} ratio="9 / 16" />
        <div class="block block--sub">
          <Stage num="01" cap={false}>The hook</Stage>
          <h3 class="h-l">{R.hook.title}</h3>
          <p class="note">{R.hook.copy}</p>
          <p><a class="pill pill--white pill--sm dl" href={R.hook.gif} download={`${R.hook.file}.gif`}><Fragment set:html={DL} />GIF <small>{R.hook.gifSize}</small><span class="sr-only">: the reel hook</span></a></p>
        </div>
      </div>
      <div class="block block--sub indent reveal">
        <Stage num="02" cap={false}>Titles</Stage>
        <h3 class="h-l">{R.titlesTitle}</h3>
      </div>
      <ul class="phones reveal">
        {fitTitles.map((t) => (
          <li class="phone">
            <img class="shot" src={t.img} width="540" height="960" alt={t.alt} loading="lazy" decoding="async" />
            <p class="n">{t.n}{t.badge && <span class="badge">{t.badge}</span>}</p>
            <h4 class="phone__t">{t.name}</h4>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
      <div class="block block--sub indent reveal">
        <Stage num="03" cap={false}>Captions</Stage>
        <h3 class="h-l">{R.captionsTitle}</h3>
      </div>
      <ul class="phones reveal">
        {fitReels.map((r) => (
          <li class="phone" data-loop-host>
            <Loop name={r.loop} alt={r.alt} ratio="9 / 16" />
            <p class="n">{r.n}{r.badge && <span class="badge">{r.badge}</span>}</p>
            <h4 class="phone__t">{r.name}</h4>
            <p>{r.text}</p>
            <a class="pill pill--white pill--sm dl" href={r.gif} download={`${r.file}.gif`}><Fragment set:html={DL} />GIF <small>{r.gifSize}</small><span class="sr-only">: caption style {r.n}, {r.name}</span></a>
          </li>
        ))}
      </ul>
      <Features items={R.notes} level="h3" class="reveal" label="How the reels were made" />
    </section>

    <CaseEnd ask={fitrise.ask} subject={fitrise.subject} next={{ href: '/work/cissp-masterclass-ads/', client: 'Destination Certification', title: 'CISSP MasterClass ads', loop: 'cissp-ad1-sort', alt: 'CISSP ad: a personal review guide re-sorts itself, pulling the weakest exam domains to the top.' }} />
  </main>
</Pearl>
