---
import Pearl from '../layouts/Pearl.astro';
import Stage from '../components/pearl/Stage.astro';
import Loop from '../components/pearl/Loop.astro';
---
<Pearl title="Page not found — Toli Herasymenko" noindex>
  <main id="main">
    <section class="hero section nf" aria-labelledby="nf-title">
      <div class="wrap nf__grid">
        <div class="block">
          <Stage>404 · 00:00:00:00</Stage>
          <h1 class="h-hero" id="nf-title">This frame was cut.</h1>
          <p class="t-lead">The page you asked for is not in the edit. The work and the brief form are one click away.</p>
          <div class="hero__cta">
            <a class="pill pill--solid pill--lg" href="/#work">See the work</a>
            <a class="pill pill--white pill--lg" href="/#contact">Start a project</a>
          </div>
        </div>
        <div class="nf__media" data-loop-host><Loop name="bf-kinetic" eager alt="Kinetic type loop: big black and red words fill a tall frame." ratio="9 / 16" /></div>
      </div>
    </section>
  </main>
</Pearl>

<style>
  .nf__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 96px); align-items: center; min-height: 60vh; }
  .nf__media { max-width: 300px; justify-self: center; width: 100%; }
  @media (max-width: 760px) { .nf__grid { grid-template-columns: 1fr; } .nf__media { max-width: 200px; justify-self: start; } }
</style>
