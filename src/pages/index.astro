    <Hero />
    <WorkGrid />
    <Process />
    <Services />
    <Agencies />
    <AiNote />
    <About />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <ReelDialog />
  <MobileCta />
</Base>
